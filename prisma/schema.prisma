generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  username      String?      @unique
  password      String?
  accounts      Account[]
  sessions      Session[]
  testResults   TestResult[]
  todos         Todo[]
  tags          Tag[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TestResult {
  id        String   @id @default(cuid())
  wpm       Int
  rawWpm    Int
  accuracy  Float
  duration  Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

model Todo {
  id                String         @id @default(cuid())
  title             String
  description       String?
  notes             String?        @db.Text
  completed         Boolean        @default(false)
  completedAt       DateTime?
  priority          Priority       @default(MEDIUM)
  startDate         DateTime?
  dueDate           DateTime?
  estimatedMinutes  Int?
  energyLevel       EnergyLevel?
  context           String?
  location          String?
  order             Int            @default(0)
  recurrence        RecurrenceRule @default(NONE)
  recurringParentId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks Subtask[]
  tags     TodoTag[]
  links    TodoLink[]

  // Dependencies (self-relation via TodoDependency join).
  dependsOn TodoDependency[] @relation("BlockedTask") // tasks this one waits on
  blocking  TodoDependency[] @relation("BlockingTask") // tasks waiting on this one

  @@index([userId, completed, dueDate])
  @@index([userId, completed, completedAt])
  @@index([userId, createdAt])
}

model TodoLink {
  id        String   @id @default(cuid())
  url       String
  title     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
}

model TodoDependency {
  blockedId  String // the task that is blocked
  blockingId String // the task that must be completed first

  blocked  Todo @relation("BlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)
  blocking Todo @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)

  @@id([blockedId, blockingId])
  @@index([blockingId])
}

model Subtask {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)

  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String

  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos  TodoTag[]

  @@unique([userId, name])
}

model TodoTag {
  todoId String
  tagId  String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([todoId, tagId])
}
