# Luff-Everyday Environment Variables
# Copy this file to .env and fill in values

# ── Database (Neon / Supabase / any PostgreSQL) ──────────────────────────────
# DATABASE_URL: pooled connection (PgBouncer), used at runtime by the app.
# DIRECT_URL: unpooled connection, required by Prisma Migrate — pooled/transaction-mode
# connections don't support the session-level operations migrations need. On Neon, this
# is the same host with "-pooler" removed.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth.js (v5, package name still "next-auth") ─────────────────────────────
# This app intentionally keeps the legacy NEXTAUTH_*/GOOGLE_CLIENT_* names below
# instead of Auth.js v5's AUTH_*/AUTH_GOOGLE_* convention, since
# src/features/auth/config.ts passes them explicitly rather than relying on
# auto-detection. Renaming them silently breaks Google sign-in. See docs/auth.md.
# Set NEXTAUTH_URL to your production URL on Vercel (auto-detected, but explicit is safer)
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-random-32-char-secret"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudinary (image uploads: profile avatar, todo images) ──────────────────
# Free tier: ~25GB storage + ~25GB bandwidth/month. Create an account at
# cloudinary.com, then copy these three values from the dashboard's "Account
# Details" panel. Used by src/shared/lib/cloudinary.ts via the generic
# /api/upload route (src/app/api/upload/route.ts).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
